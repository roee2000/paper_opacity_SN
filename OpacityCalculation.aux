\newlabel{fig:rosseland_planck_ni}{{3}{5}{Type~Ia core composition at $t=10$~days: $\kappa _R^{\rm exp}$ (left) and $\kappa _P^{\rm tot}/\kappa _R^{\rm exp}$ ratio (right). Density $10^{-14}$--$10^{-10}$~g/cm$^3$}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Type~Ia outer-layer composition at $t=10$~days: $\kappa _R^{\rm  exp}$ (left) and $\kappa _P^{\rm  tot}/\kappa _R^{\rm  exp}$ ratio (right). The composition is Si, S, Ar, and Ca with mass fractions 0.535, 0.32, 0.062, and 0.083. Density $10^{-14}$--$10^{-10}$~g/cm$^3$. The ratio stays near unity because the opacity is dominated by Thomson scattering and free-free absorption.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:rosseland_planck_sn1a_outer}{{4}{5}{Type~Ia outer-layer composition at $t=10$~days: $\kappa _R^{\rm exp}$ (left) and $\kappa _P^{\rm tot}/\kappa _R^{\rm exp}$ ratio (right). The composition is Si, S, Ar, and Ca with mass fractions 0.535, 0.32, 0.062, and 0.083. Density $10^{-14}$--$10^{-10}$~g/cm$^3$. The ratio stays near unity because the opacity is dominated by Thomson scattering and free-free absorption}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Kilonova composition at $t=1$~day: $\kappa _R^{\rm  exp}$ (left) and $\kappa _P^{\rm  tot}/\kappa _R^{\rm  exp}$ ratio (right). Density $10^{-14}$--$10^{-9}$~g/cm$^3$.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:rosseland_planck_kilonova}{{5}{6}{Kilonova composition at $t=1$~day: $\kappa _R^{\rm exp}$ (left) and $\kappa _P^{\rm tot}/\kappa _R^{\rm exp}$ ratio (right). Density $10^{-14}$--$10^{-9}$~g/cm$^3$}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Effective expansion Rosseland mean, $\kappa _R^{\rm  exp}$, as a function of temperature for fixed densities $\rho =10^{-14}$ and $10^{-12}$~g/cm$^3$. The plotted table times are $t=1$~day for Type~Ia and $t=1.35721$~days for the kilonova. Type~Ia outer-layer composition is shown in blue and kilonova composition in orange. Dark and light curves correspond to the lower and higher density, respectively.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:kappa_slice_T}{{6}{6}{Effective expansion Rosseland mean, $\kappa _R^{\rm exp}$, as a function of temperature for fixed densities $\rho =10^{-14}$ and $10^{-12}$~g/cm$^3$. The plotted table times are $t=1$~day for Type~Ia and $t=1.35721$~days for the kilonova. Type~Ia outer-layer composition is shown in blue and kilonova composition in orange. Dark and light curves correspond to the lower and higher density, respectively}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Effective expansion Rosseland mean, $\kappa _R^{\rm  exp}$, as a function of density for fixed temperatures $T=0.5$ and $1$~eV. The plotted table times are $t=1$~day for Type~Ia and $t=1.35721$~days for the kilonova. Type~Ia outer-layer composition is shown in blue and kilonova composition in orange. Dark and light curves correspond to the lower and higher temperature, respectively.}}{6}{figure.7}\protected@file@percent }
\newlabel{fig:kappa_slice_rho}{{7}{6}{Effective expansion Rosseland mean, $\kappa _R^{\rm exp}$, as a function of density for fixed temperatures $T=0.5$ and $1$~eV. The plotted table times are $t=1$~day for Type~Ia and $t=1.35721$~days for the kilonova. Type~Ia outer-layer composition is shown in blue and kilonova composition in orange. Dark and light curves correspond to the lower and higher temperature, respectively}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Density profiles of the Type~Ia and kilonova ejecta at $t=1$ day. The simulations assume spherical homologous expansion, so each shell keeps a fixed velocity and its radius grows as $r=vt$. The Type~Ia model is centrally concentrated and slower, while the kilonova model occupies faster, lower-density ejecta.}}{7}{figure.8}\protected@file@percent }
\newlabel{fig:ejecta_geometry}{{8}{7}{Density profiles of the Type~Ia and kilonova ejecta at $t=1$ day. The simulations assume spherical homologous expansion, so each shell keeps a fixed velocity and its radius grows as $r=vt$. The Type~Ia model is centrally concentrated and slower, while the kilonova model occupies faster, lower-density ejecta}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Bolometric luminosity from the Type~Ia and kilonova validation simulations. For each ejecta model we compare the single-group calculation using $\kappa _R^{\rm  exp}$ with the corresponding full frequency-group calculation.}}{7}{figure.9}\protected@file@percent }
\newlabel{fig:comparison}{{9}{7}{Bolometric luminosity from the Type~Ia and kilonova validation simulations. For each ejecta model we compare the single-group calculation using $\kappa _R^{\rm exp}$ with the corresponding full frequency-group calculation}{figure.9}{}}
