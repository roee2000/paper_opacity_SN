\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Effective expansion Rosseland opacity for the five kilonova compositions and one Type~Ia outer-layer composition. Left: temperature dependence at $\rho =10^{-13}$~g/cm$^3$; the dotted line marks $T=1.2$~eV. Right: density dependence at $T=1$~eV. Both compositions are evaluated at exactly one day.}}{10}{figure.10}\protected@file@percent }
\newlabel{fig:kappa_composition_slices}{{10}{10}{Effective expansion Rosseland opacity for the five kilonova compositions and one Type~Ia outer-layer composition. Left: temperature dependence at $\rho =10^{-13}$~g/cm$^3$; the dotted line marks $T=1.2$~eV. Right: density dependence at $T=1$~eV. Both compositions are evaluated at exactly one day}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Velocity (left), plasma temperature (middle), and density (right) at the kilonova diffusion surface $t_{\rm  diff}=t$, for six lanthanide mass fractions. The dotted line marks $T=1.8$~eV, the maximum temperature reached by the diffusion surface.}}{10}{figure.11}\protected@file@percent }
\newlabel{fig:kilonova_diffusion_surface}{{11}{10}{Velocity (left), plasma temperature (middle), and density (right) at the kilonova diffusion surface $t_{\rm diff}=t$, for six lanthanide mass fractions. The dotted line marks $T=1.8$~eV, the maximum temperature reached by the diffusion surface}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Effective expansion Rosseland opacity sampled by the diffusion region. Left: local opacity at the Type~Ia diffusion surface, which remains inside the Ni-rich layer throughout the calculation. Right: column-averaged opacity outside the kilonova diffusion surface for the six compositions.}}{10}{figure.12}\protected@file@percent }
\newlabel{fig:kappa_eff_t}{{12}{10}{Effective expansion Rosseland opacity sampled by the diffusion region. Left: local opacity at the Type~Ia diffusion surface, which remains inside the Ni-rich layer throughout the calculation. Right: column-averaged opacity outside the kilonova diffusion surface for the six compositions}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Robustness of the composition-dependent gray opacity. Left: density profiles at one day; the shaded region marks $0.1c<v<0.3c$. Right: logarithmic-time-weighted mean and standard deviation of $\kappa _{\rm  avg}$ while the diffusion surface crosses that interval. Colors identify ejecta profiles rather than compositions. The dashed curve is one fit to all 30 simulations, given by \eqref  {eq:kappa_xlan}.}}{11}{figure.13}\protected@file@percent }
\newlabel{fig:kappa_xlan}{{13}{11}{Robustness of the composition-dependent gray opacity. Left: density profiles at one day; the shaded region marks $0.1c<v<0.3c$. Right: logarithmic-time-weighted mean and standard deviation of $\kappa _{\rm avg}$ while the diffusion surface crosses that interval. Colors identify ejecta profiles rather than compositions. The dashed curve is one fit to all 30 simulations, given by \eqref {eq:kappa_xlan}}{figure.13}{}}
