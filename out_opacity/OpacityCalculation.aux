\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Examples of bound-bound line opacity showing the $\tau =1$ window smoothing algorithm. Left: illustration of the smoothing process. Right: comparison of raw opacity (solid line), smoothed opacity with fine frequency bins (dashed line), and smoothed opacity with large frequency bins (dotted line), demonstrating the effect of the $\tau =1$ window smoothing on bound-bound line transitions.}}{3}{}\protected@file@percent }
\newlabel{fig:BB_line_example}{{1}{3}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Convergence of Rosseland mean opacity as a function of the frequency resolution $\Delta \nu /\nu $. Three approaches are compared: naive opacity (without smoothing), naive saturated opacity (with expansion opacity formula but without $\tau =1$ window smoothing), and effective opacity (with full expansion opacity formalism including $\tau =1$ window smoothing).}}{3}{}\protected@file@percent }
\newlabel{fig:convergence}{{2}{3}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effective Rosseland mean opacity for nickel as a function of temperature and density at t = 1, 10, and 100 days (from left to right). The opacity is calculated using the expansion opacity formalism described in Section~\ref {SecExpansion}.}}{4}{}\protected@file@percent }
\newlabel{fig:opac_rho_T}{{3}{4}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Effective Rosseland mean opacity for nickel as a function of temperature and $\rho \cdot t$ at t = 1, 10, and 100 days (from left to right). The $\rho \cdot t$ parameter is more natural for expanding media and better illustrates the scaling behavior of expansion opacity.}}{4}{}\protected@file@percent }
\newlabel{fig:opac_rhot_T}{{4}{4}{}{figure.4}{}}
